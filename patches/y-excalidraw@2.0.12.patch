@@ -41,6 +41,21 @@ var yjsToExcalidraw = (yArray) => {
 // src/diff.ts
 import { generateKeyBetween, generateNKeysBetween } from "fractional-indexing";
 import * as Y from "yjs";
+// [ripple patch] When a change both appends and reorders elements at once,
+// freshly-appended elements still carry a placeholder pos of "" during the move
+// loop, which desyncs elementIds ordering from the real pos values. The move
+// neighbors then come out reversed (left >= right) and generateKeyBetween throws
+// `${left} >= ${right}`, propagating out of Excalidraw's onChange and tearing
+// down the route. Guard it: on inconsistent ordering, place the element just
+// after the left neighbor. Self-heals on the next clean diff (lastKnownElements
+// is re-derived sorted). See excalidraw/excalidraw#8295.
+var safeGenerateKeyBetween = (a, b) => {
+  try {
+    return generateKeyBetween(a, b);
+  } catch {
+    return generateKeyBetween(a ?? null, null);
+  }
+};
 var getDeltaOperationsForElements = (lastKnownElements, newElements, bulkify = true) => {
   const updateOperations = [];
   const appendOperations = [];
@@ -118,7 +133,7 @@ var getDeltaOperationsForElements = (lastKnownElements, newElements, bulkify = t
         leftSortIndex = opsTracker.idMap[opsTracker.elementIds[toIndex - 1]]?.pos || null;
         rightSortIndex = opsTracker.idMap[opsTracker.elementIds[toIndex]]?.pos || null;
       }
-      const newSortIndex = generateKeyBetween(leftSortIndex, rightSortIndex);
+      const newSortIndex = safeGenerateKeyBetween(leftSortIndex, rightSortIndex);
       opsTracker.elementIds = moveArrayItem(opsTracker.elementIds, fromIndex, toIndex, true);
       opsTracker.idMap[id].pos = newSortIndex;
       _updateIdIndexLookup();
