{
  "name": "ripple-admin",
  "compatibility_date": "2026-02-07",
  // Static-asset-only deployment (no Worker script, no Durable Objects — unlike
  // apps/web, which bundles the partykit DOs). The admin SPA talks directly to
  // the same Convex deployment over the network via VITE_CONVEX_URL.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "admin.conduits.space",
      "custom_domain": true
    }
  ]
}
