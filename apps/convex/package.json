{
  "name": "@ripple/convex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./_generated/api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./_generated/dataModel": {
      "types": "./convex/_generated/dataModel.d.ts",
      "default": "./convex/_generated/dataModel.js"
    },
    "./_generated/server": {
      "types": "./convex/_generated/server.d.ts",
      "default": "./convex/_generated/server.js"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy && convex run migrations:runAll --prod && convex run version:set --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit && eslint ."
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@blocknote/core": "0.54.0",
    "@convex-dev/action-retrier": "^0.3.1",
    "@convex-dev/aggregate": "0.3.0",
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/migrations": "0.3.6",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/resend": "0.2.7",
    "@convex-dev/workpool": "0.4.10",
    "@ripple/shared": "workspace:*",
    "convex": "1.45.0",
    "convex-audit-log": "workspace:*",
    "convex-cascading-delete": "workspace:*",
    "convex-helpers": "0.1.123",
    "convex-webhook-receiver": "^1.0.6",
    "fractional-indexing": "4.0.0",
    "jsdom": "^25.0.1",
    "resend": "6.24.0",
    "web-push": "3.6.7",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.9",
    "@types/web-push": "3.6.4",
    "convex-test": "0.0.56",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11"
  }
}
