{
  "name": "ripple",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm -C apps/convex exec convex dev --start 'pnpm -w run dev:fleet'",
    "dev:fleet": "turbo run dev --filter=!@ripple/convex",
    "dev:admin": "pnpm -C apps/convex exec convex dev --start 'pnpm -w run dev:admin:fleet'",
    "dev:admin:fleet": "turbo run dev --filter=@ripple/admin",
    "dev:frontend": "pnpm --filter @ripple/web dev",
    "dev:backend": "pnpm --filter @ripple/convex dev",
    "dev:partykit": "pnpm --filter @ripple/partykit dev",
    "dev:rsvp-worker": "pnpm --filter @ripple/rsvp-worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @ripple/web test:watch",
    "test:backend": "pnpm --filter @ripple/convex test",
    "test:frontend": "pnpm --filter @ripple/web test",
    "deploy:convex": "pnpm --filter @ripple/convex run deploy",
    "migrate": "pnpm --filter @ripple/convex exec convex run migrations:runAll",
    "deploy:frontend": "pnpm --filter @ripple/web run deploy",
    "deploy:rsvp-worker": "pnpm --filter @ripple/rsvp-worker run deploy",
    "deploy": "pnpm --filter @ripple/web run build && pnpm --filter @ripple/convex run deploy && pnpm --filter @ripple/web run deploy && pnpm --filter @ripple/rsvp-worker run deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "dotenv": "17.4.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
