{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev:setup": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@ripple/convex#dev:setup"]
    },
    "@ripple/admin#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@ripple/convex#dev:setup"],
      "with": ["@ripple/convex#dev"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "deploy": {
      "dependsOn": ["build", "^deploy"],
      "cache": false
    }
  }
}
